{
  "name": "heroui-vue",
  "version": "0.0.19",
  "keywords": [
    "heroui",
    "tailwindcss",
    "ui",
    "ui framework",
    "vue"
  ],
  "bugs": {
    "url": "https://github.com/heroui-vue/heroui-vue/issues"
  },
  "license": "MIT",
  "author": {
    "name": "hotdog",
    "email": "hotdogc1017@gmail.com",
    "url": "https://github.com/hotdogc1017"
  },
  "repository": "https://github.com/heroui-vue/heroui-vue",
  "files": [
    "dist"
  ],
  "type": "module",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": "./dist/index.mjs",
    "./plugin": "./dist/heroui.mjs"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "dev": "tsdown -w",
    "build": "pnpm -w build:shared && pnpm -w build:icon && pnpm -w build:components && tsdown --minify",
    "bump": "pnpm build && bumpp --tag v --sign"
  },
  "devDependencies": {
    "@heroui-vue/core": "workspace:*",
    "@heroui/theme": "catalog:prod"
  }
}
