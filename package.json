{
  "name": "heroui-vue-project",
  "version": "0.0.12",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --parallel --filter \"./packages/components/*\" --filter \"./packages/core\" --filter \"./packages/icon\" dev",
    "dev:docs": "pnpm run -C docs dev",
    "build": "pnpm --filter \"./packages/components/*\"  --filter \"./packages/core\" build",
    "build:core": "pnpm --filter \"./packages/core\" build",
    "build:cmp": "pnpm --filter \"./packages/components/*\" build",
    "build:icon": "pnpm --filter \"@heroui-vue/icon\" build",
    "build:doc": "pnpm build:cmp && pnpm -C docs build",
    "clean": "rimraf -g **/node_modules **/dist",
    "clean:dist": "rimraf -g **/dist",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "bump": "pnpm -C packages/core run bump && pnpm -C packages/heroui-vue run bump",
    "bump:button": "pnpm -C packages/components/button run bump",
    "bump:alert": "pnpm -C packages/components/alert run bump",
    "bump:chip": "pnpm -C packages/components/chip run bump",
    "bump:avatar": "pnpm -C packages/components/avatar run bump",
    "bump:badge": "pnpm -C packages/components/badge run bump",
    "bump:checkbox": "pnpm -C packages/components/checkbox run bump",
    "bump:accordion": "pnpm -C packages/components/accordion run bump",
    "nvc": "heroui-vue-create",
    "pub:view": "pnpm publish -r --dry-run --registry=https://registry.npmjs.org/"
  },
  "dependencies": {
    "oxfmt": "^0.75.0"
  },
  "devDependencies": {
    "bumpp": "^12.3.0",
    "heroui-vue-create": "workspace:*",
    "oxlint": "^1.90.0",
    "pnpm": "^12.15.0",
    "rimraf": "^6.1.3",
    "tsdown": "^0.23.2",
    "typescript": "^7.0.2"
  },
  "packageManager": "pnpm@12.15.0"
}
