{
  "name": "@heroui-vue/docs",
  "version": "0.0.12",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vitepress dev",
    "build:base": "pnpm -w build:shared && pnpm -w build:icon",
    "build:components": "pnpm -w build:alert && pnpm -w build:avatar && pnpm -w build:button && pnpm -w build:chip",
    "build": "pnpm build:base && pnpm build:components && vitepress build",
    "preview": "pnpm build && vitepress preview"
  },
  "devDependencies": {
    "@heroui-vue/alert": "workspace:*",
    "@heroui-vue/avatar": "workspace:*",
    "@heroui-vue/button": "workspace:*",
    "@heroui-vue/chip": "workspace:*",
    "@heroui-vue/icon": "workspace:*",
    "@heroui/theme": "catalog:prod",
    "@tailwindcss/vite": "catalog:prod",
    "@vue/tsconfig": "catalog:prod",
    "tailwindcss": "catalog:prod",
    "vitepress": "next",
    "vitepress-plugin-group-icons": "^1.8.1",
    "vitepress-plugin-npm-commands": "^0.10.0",
    "vitepress-plugin-sfc": "2.0.0-beta.6",
    "vitepress-plugin-tabs": "^0.7.3"
  }
}
